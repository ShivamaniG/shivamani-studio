# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TESTIMONIAL EMAIL:
# Use this with a form/email provider endpoint, for example Formspree, Web3Forms,
# or your own serverless API route. The testimonial form POSTs JSON here.
VITE_TESTIMONIAL_EMAIL_ENDPOINT="MY_TESTIMONIAL_EMAIL_ENDPOINT"

# Optional local fallback. If no endpoint is configured, the app can open the
# visitor's email client with a pre-filled testimonial draft to this address.
VITE_TESTIMONIAL_TO_EMAIL="your-email@example.com"
